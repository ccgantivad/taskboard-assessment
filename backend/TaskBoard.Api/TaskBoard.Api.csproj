<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e8d73dd2-1f37-4955-ad01-e0044293701b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <!-- Override SqlClient's vulnerable transitive 9.0.11 dependency. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.22" />
  </ItemGroup>

</Project>
